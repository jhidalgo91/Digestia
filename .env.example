# DigestAI - Variables de entorno
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA subas .env.local al repositorio (está en .gitignore).

# ─────────────────────────────────────────────────────────────────────────────
# Base de datos (MySQL 8+)
# Formato: mysql://<usuario>:<contraseña>@<host>:<puerto>/<nombre_bd>
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://usuario:contraseña@localhost:3306/digestia"

# ─────────────────────────────────────────────────────────────────────────────
# NextAuth.js – autenticación
# NEXTAUTH_URL: URL base de la aplicación (sin barra final)
# NEXTAUTH_SECRET: secreto aleatorio de mínimo 32 caracteres
#   Genera uno con: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-seguro-de-32-caracteres"

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI – módulo IA (análisis nutricional y chatbot)
# Obtén tu API key en: https://platform.openai.com/api-keys
# Modelo usado: gpt-4o-mini
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ─────────────────────────────────────────────────────────────────────────────
# Resend – envío de emails y notificaciones
# Obtén tu API key en: https://resend.com/api-keys
# RESEND_FROM_EMAIL debe ser un dominio verificado en Resend
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@digestai.app"

