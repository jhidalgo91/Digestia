# DigestAI - Variables de entorno
# Copia este archivo como .env.local y rellena los valores
#
# Generación rápida del NEXTAUTH_SECRET:
#   openssl rand -base64 32

# ─────────────────────────────────────────────────────────────────────────────
# Base de datos (MySQL)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://usuario:contraseña@localhost:3306/digestia"

# ─────────────────────────────────────────────────────────────────────────────
# NextAuth.js
# ─────────────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-seguro"

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI (módulo IA - análisis nutricional y chatbot)
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ─────────────────────────────────────────────────────────────────────────────
# Resend (envío de emails y notificaciones)
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@digestai.app"

# ─────────────────────────────────────────────────────────────────────────────
# Comportamiento de Prisma
# ─────────────────────────────────────────────────────────────────────────────
# Desactiva la telemetría de Prisma (evita conexiones a checkpoint.prisma.io)
CHECKPOINT_DISABLE="1"

# ─────────────────────────────────────────────────────────────────────────────
# Telemetría de Next.js
# ─────────────────────────────────────────────────────────────────────────────
# Desactiva la telemetría de Next.js en entornos de desarrollo/CI
NEXT_TELEMETRY_DISABLED="1"

# ─────────────────────────────────────────────────────────────────────────────
# Variables opcionales (para funcionalidades futuras)
# ─────────────────────────────────────────────────────────────────────────────
# URL pública de la aplicación (para emails y webhooks)
# NEXT_PUBLIC_APP_URL="https://digestai.app"

# Proveedor OAuth Google (para login social)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
